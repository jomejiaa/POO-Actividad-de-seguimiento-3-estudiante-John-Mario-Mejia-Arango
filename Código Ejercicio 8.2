    private void calcularActionPerformed(java.awt.event.ActionEvent evt) {                                         
        Notas notas = new Notas();
    
        String nota1Str = campoNota1.getText().trim();
        String nota2Str = campoNota2.getText().trim();
        String nota3Str = campoNota3.getText().trim();
        String nota4Str = campoNota4.getText().trim();
        String nota5Str = campoNota5.getText().trim();
    
        if (nota1Str.isEmpty()) {
            JOptionPane.showMessageDialog(this, "El campo nota 1 no puede estar vacio.", "Error de Validación", JOptionPane.WARNING_MESSAGE);
            campoNota1.requestFocus();
            return; //detener ejecución para que no siga evaluando.
        }
        
        if(nota2Str.isEmpty()) {
            JOptionPane.showMessageDialog(this, "El campo nota 2 no puede estar vacio.", "Error de Validación", JOptionPane.WARNING_MESSAGE);
            campoNota1.requestFocus();
            return;
        }
        
        if(nota3Str.isEmpty()) {
            JOptionPane.showMessageDialog(this, "El campo nota 3 no puede estar vacio.", "Error de Validación", JOptionPane.WARNING_MESSAGE);
            campoNota1.requestFocus();
            return;
        } 
       
        if(nota4Str.isEmpty()) {
            JOptionPane.showMessageDialog(this, "El campo nota 4 no puede estar vacio.", "Error de Validación", JOptionPane.WARNING_MESSAGE);
            campoNota1.requestFocus();
            return;
        } 
 
        if(nota5Str.isEmpty()) {
            JOptionPane.showMessageDialog(this, "El campo nota 5 no puede estar vacio.", "Error de Validación", JOptionPane.WARNING_MESSAGE);
            campoNota1.requestFocus();
            return;
        }        
        
    // cambiooooo 
    //Validar que sean datos numéricos y convertirlos
    double valor1, valor2, valor3, valor4, valor5;
        
            try {
                valor1= Double.parseDouble(nota1Str);
                valor2= Double.parseDouble(nota2Str);
                valor3= Double.parseDouble(nota3Str);
                valor4= Double.parseDouble(nota4Str);
                valor5= Double.parseDouble(nota5Str);
            
            } catch (NumberFormatException e) {
                //Si ocurre esta excepción, significa que no era un número
                JOptionPane.showMessageDialog(this,
                        "Por favor, ingresa solo valores numéricos.", "Error de formato", JOptionPane.ERROR_MESSAGE);
                return; // Detiene la ejecución si hay un error de formato.
                
            }
            
        //3. Asignar los valores a la clase Notas y realizar los calculos.
        
        notas.listaNotas[0]=valor1;
        notas.listaNotas[1]=valor2;
        notas.listaNotas[2]=valor3;
        notas.listaNotas[3]=valor4;
        notas.listaNotas[4]=valor5;
        
        double promedioVal = notas.calcularPromedio();
        double desv = notas.calcularDesviación();
        double mayorVal = notas.calcularMayor();
        double menorVal = notas.calcularMenor();
        
        // 4. Mostrar los resultados en la interfaz
        promedio.setText("Promedio = " + String.format("%.2f", promedioVal));
        desviación.setText("Desviación estándar = " + String.format("%.2f", desv));
        mayor.setText("Valor mayor = " + mayorVal);
        menor.setText("Valor menor = " + menorVal);            
    }                                        

