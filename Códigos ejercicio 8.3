//Cilindro.java
package com.mycompany.actividad3ejercicio8punto3;

public class Cilindro extends FiguraGeométrica{
    
    private double radio;
    private double altura;

    public Cilindro(double radio, double altura) {
        this.radio = radio;
        this.altura = altura;
        this.setVolumen(calcularVolumen());
        this.setSuperficie(calcularSuperficie());
    }
    
    public double calcularVolumen() {
        double volumen = Math.PI * altura * Math.pow(radio, 2.0);
        return volumen;
    }

    public double calcularSuperficie() {
        double áreaLadoA = 2.0 * Math.PI * radio * altura;
        double áreaLadoB = 2.0 * Math.PI * Math.pow(radio, 2.0);
    return áreaLadoA + áreaLadoB;
    }
    
}

//Cubo.java
package com.mycompany.actividad3ejercicio8punto3;

public class Cubo extends FiguraGeométrica{

    private double lado;

    public Cubo(double lado) {
        this.lado = lado;
        this.setVolumen(calcularVolumen());
        this.setSuperficie(calcularSuperficie());
    }
    
    public double calcularVolumen() {
        return Math.pow(this.lado, 3.0);
    }
    
    public double calcularSuperficie() {
        return 6.0 * Math.pow(this.lado, 2.0);
    }
}

//Esfera.java
package com.mycompany.actividad3ejercicio8punto3;

public class Esfera extends FiguraGeométrica{
    private double radio;
    

    public Esfera(double radio) {
        this.radio = radio;
        this.setVolumen(calcularVolumen());
        this.setSuperficie(calcularSuperficie());
    }

    public double calcularVolumen() {
        double volumen = 1.333 * Math.PI * Math.pow(this.radio, 3.0);
        return volumen;
    }

    public double calcularSuperficie() {
        double superficie = 4.0 * Math.PI * Math.pow(this.radio, 2.0);
        return superficie;
    }
}

//Piramide.java
package com.mycompany.actividad3ejercicio8punto3;

public class Piramide extends FiguraGeométrica{
    private double base;
    private double altura;
    private double apotema;
    
    public Piramide(double base, double altura, double apotema) {
        this.base = base;
        this.altura = altura;
        this.apotema = apotema;
        this.setVolumen(calcularVolumen());
        this.setSuperficie(calcularSuperficie());
    }
    
    public double calcularVolumen() {
        double volumen = (Math.pow(base, 2.0) * altura) / 3.0;
        return volumen;
    }

    public double calcularSuperficie() {
        double áreaBase = Math.pow(base, 2.0);
        double áreaLado = 2.0 * base * apotema;
        return áreaBase + áreaLado;
    }
}

//Prisma.java
package com.mycompany.actividad3ejercicio8punto3;

public class Prisma extends FiguraGeométrica{

    private double base;
    private double profundidad;
    private double altura;

    public Prisma(double base, double profundidad, double altura) {
        this.base = base;
        this.profundidad = profundidad;
        this.altura = altura;
        this.setVolumen(calcularVolumen());
        this.setSuperficie(calcularSuperficie());
    }

    public double calcularVolumen() {
        return base * profundidad * altura;
    }

    public double calcularSuperficie() {
        return 2.0 * (base * profundidad + base * altura + profundidad * altura);
    }
}

